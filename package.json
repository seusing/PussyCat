{
  "name": "opencli-app-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:node": "vite --mode node --strictPort",
    "dev:server": "node --watch server/index.mjs",
    "start:server": "node server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "bench:append": "node scripts/bench-append-output.mjs",
    "build:host": "node scripts/build-host-runtime.mjs",
    "build:vk-bundle": "node scripts/build-vk-bundle.mjs",
    "verify:host": "node scripts/verify-host-closure.mjs",
    "check:legacy": "node scripts/check-legacy-baseline.mjs",
    "package": "node scripts/package-app.mjs",
    "package:check": "node scripts/package-app.mjs --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jackwener/opencli": "1.8.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "animejs": "4.5.0",
    "border-beam": "^1.3.0",
    "generative-loaders": "^0.1.1",
    "lucide": "1.33.0",
    "lucide-react": "^1.28.0",
    "morphicons": "1.7.0",
    "motion": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "thinking-orbs": "^0.2.0",
    "undici": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
